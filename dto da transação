class TransactionDTO:
    @staticmethod
    def to_dict(tx) -> dict:
        return {
            "transaction_key": tx.transaction_key,
            "gross_amount": tx.gross_amount,
            "fee_amount": tx.fee_amount,
            "net_amount": tx.net_amount,
            "created_at": tx.created_at.isoformat() if tx.created_at else None
        }
