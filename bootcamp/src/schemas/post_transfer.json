  "properties": {
    "source_account_key": {
      "type": "string",
      "format": "uuid"
    },
    "destination_account_key": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "type": "integer",
      "minimum": 1
    }
  },
